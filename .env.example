# =============================================================================
# MMUST DCBT - VPS Production Environment Configuration
# =============================================================================

# Server settings
PORT=5000
NODE_ENV=production

# Database Configuration (Option A: Local Docker PostgreSQL)
POSTGRES_DB=mmust_dcbt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_MIN_24_CHARS>
# If using the local db container, leave DATABASE_URL as below (or empty so docker-compose defaults it):
DATABASE_URL=postgresql://postgres:<GENERATE_STRONG_PASSWORD_MIN_24_CHARS>@db:5432/mmust_dcbt
DB_SSL=false

# Daily Disaster Recovery Replica (Neon Cloud Database)
# Used by scripts/sync_to_neon.sh to keep an offsite clone synced every night
NEON_DATABASE_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>/<NEON_DB>?sslmode=require

# Database Configuration (Option B: External Neon / Cloud PostgreSQL)
# If using Neon, uncomment and set DATABASE_URL (and set DB_SSL=true if not using sslmode in URL):
# DATABASE_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>/<NEON_DB>?sslmode=require
# DB_SSL=true

# Security & Authentication (Minimum 32 characters in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=<GENERATE_64_CHAR_HEX_SECRET_VIA_OPENSSL>

# AI Service (Google Gemini)
GEMINI_API_KEY=<YOUR_GOOGLE_GEMINI_API_KEY>

# Email Delivery (Nodemailer / Gmail App Password)
EMAIL_USER=<YOUR_SYSTEM_EMAIL@GMAIL.COM>
EMAIL_PASS=<YOUR_16_CHAR_GMAIL_APP_PASSWORD>

# CORS Allowed Origins (Comma-separated domains or IP of your VPS)
# Example: https://yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Frontend Build Variables (Used by Client and Admin during Vite build)
# If using reverse proxy on same domain: /api/v1
# If using separate API domain: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1
